---
interface Props {
  title: string
  description?: string
}

const { title, description = 'GPU-accelerated async transcription microservice — self-hosted, LAN-only, machine-to-machine.' } = Astro.props
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-brand">WhisperQueue</a>
        <div class="nav-links">
          <a href="/docs">Docs</a>
          <a href="https://github.com/WhisperQueue">GitHub</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        GPU-accelerated transcription — self-hosted, LAN-only
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    border-bottom: 1px solid var(--wq-border);
    background-color: var(--wq-void);
  }

  .nav-inner {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
  }

  .nav-brand {
    font-weight: 500;
    color: var(--wq-text);
    transition: color 150ms;
  }

  .nav-brand:hover {
    color: var(--wq-accent-lt);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.875rem;
  }

  .nav-links a {
    color: var(--wq-muted);
    transition: color 150ms;
  }

  .nav-links a:hover {
    color: var(--wq-accent-lt);
  }

  .footer {
    border-top: 1px solid var(--wq-border);
    padding: 2rem 0;
  }

  .footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--wq-faint);
  }
</style>